{
  "expo": {
    "name": "Maua Learn",
    "slug": "maua-learn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/maua-app-icon.png",
    "scheme": "maualearn",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/maua-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E",
        "foregroundImage": "./assets/images/maua-adaptive.png",
        "monochromeImage": "./assets/images/maua-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.masonix.maualearn"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/maua-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/maua-mark.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7476848a-4143-4c02-8060-c3b68b61657e"
      }
    }
  }
}
